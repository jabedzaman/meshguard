# syntax=docker/dockerfile:1.4
FROM golang:1.27

RUN go install github.com/air-verse/air@latest

WORKDIR /app

# Source is bind-mounted by docker-compose.override.yaml. AIR_CMD names the
# binary under ./cmd to build and run, e.g. mesh-relay.
CMD ["sh", "-c", "air --build.cmd \"go build -o /tmp/$AIR_CMD ./cmd/$AIR_CMD\" --build.entrypoint \"/tmp/$AIR_CMD\" --build.include_ext go --build.exclude_dir bin --build.poll true --tmp_dir /tmp/air"]
