# syntax=docker/dockerfile:1.4
# Agent + CLI in a small image for the two-device lab (`pnpm lab`). Builds
# without go.work, which also checks the standalone module setup.
FROM golang:1.27 AS build
WORKDIR /src
COPY internal internal
COPY apps/agent apps/agent
COPY apps/cli apps/cli
ENV GOWORK=off CGO_ENABLED=0
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    cd apps/agent && go build -o /out/meshguard-agent ./cmd/meshguard-agent && \
    cd ../cli && go build -o /out/meshguard ./cmd/meshguard

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iptables iputils-ping dnsutils netcat-openbsd openssl curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
ENV MESHGUARD_SOCKET=/run/meshguard/agent.sock MESHGUARD_STATE_DIR=/var/lib/meshguard
CMD ["meshguard-agent"]
