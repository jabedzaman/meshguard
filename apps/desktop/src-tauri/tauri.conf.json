{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeshGuard",
  "mainBinaryName": "MeshGuard",
  "version": "0.1.0",
  "identifier": "dev.jabed.meshguard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MeshGuard",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/meshguard-agent": "bin/meshguard-agent",
      "bin/meshguard": "bin/meshguard"
    },
    "category": "Utility",
    "shortDescription": "Private mesh networking",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
