{
  "name": "@mesh/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config auth.cli.ts --output ../db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@mesh/db": "workspace:^",
    "better-auth": "^1.7.7"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "auth": "1.7.7"
  }
}
