{
  "name": "mesh",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "watch": "turbo run watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "proto:gen": "pnpm --filter @mesh/proto gen",
    "build:packages": "turbo run build --filter=./packages/*",
    "docker:build": "docker compose build",
    "docker:up": "pnpm build:packages && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && pnpm build:packages && docker compose up -d",
    "docker:remove": "docker compose down --rmi all --volumes --remove-orphans",
    "e2e:up": "pnpm build:packages && docker compose --profile e2e up -d --build api-e2e web-e2e workers-e2e playwright",
    "e2e:down": "docker compose --profile e2e rm -sf api-e2e web-e2e workers-e2e playwright",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:e2e": "tsc -p tests/tsconfig.json",
    "lab": "bash scripts/lab.sh",
    "lab:down": "docker compose --profile lab rm -sf lab-a lab-b lab-e lab-f lab-g lab-h router-e router-g router-h",
    "test:systemd": "bash scripts/test-systemd.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "^5.9.3"
  }
}
