DATABASE_URL=postgres://mesh:mesh@localhost:5432/mesh
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: enables "Sign in with GitHub". Callback URL:
# http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email. In development Mailpit catches everything: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Mesh <no-reply@mesh.local>
API_PORT=4000
LOG_LEVEL=info

# Host ports published by docker compose. Change these if they clash with
# other projects; update the matching URLs above to point at the new port.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
API_HOST_PORT=4000
WEB_HOST_PORT=3000
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
